{
  "name": "opentiles-threejs",
  "version": "0.1.0",
  "description": "Three.js client for the opentiles server: quadtree-LOD terrain streaming",
  "license": "(MIT OR Apache-2.0)",
  "type": "module",
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "module": "./dist/opentiles-threejs.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/opentiles-threejs.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "three": "^0.170.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
